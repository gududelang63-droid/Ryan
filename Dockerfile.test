FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates curl openssl python3 shellcheck \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . /workspace

ENTRYPOINT ["/bin/bash", "tests/docker_verify.sh"]
